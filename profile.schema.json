{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile dashboard settings",
  "type": "object",
  "required": ["profile", "research", "focus", "projects", "techStack", "links", "appearance", "footer"],
  "properties": {
    "$schema": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["name", "username", "headline", "affiliation", "location", "status", "about", "quickFacts"],
      "properties": {
        "name": { "type": "string", "maxLength": 40 },
        "username": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "headline": { "type": "string", "maxLength": 46 },
        "affiliation": { "type": "string", "maxLength": 40 },
        "location": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 42 },
        "about": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 320 } },
        "quickFacts": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 80 } }
      }
    },
    "research": {
      "type": "object",
      "required": ["primary", "direction", "themes", "narrative"],
      "properties": {
        "primary": { "type": "string", "maxLength": 28 },
        "direction": { "type": "string", "maxLength": 38 },
        "themes": { "type": "string", "maxLength": 46 },
        "narrative": { "type": "string", "maxLength": 420 }
      }
    },
    "focus": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string", "maxLength": 28 }, "description": { "type": "string", "maxLength": 180 } } } },
    "projects": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "object", "required": ["name", "url", "focus", "summary", "heroLabel"], "properties": { "name": { "type": "string", "maxLength": 18 }, "url": { "type": "string", "format": "uri" }, "homepage": { "type": "string" }, "focus": { "type": "string", "maxLength": 44 }, "summary": { "type": "string", "maxLength": 220 }, "heroLabel": { "type": "string", "maxLength": 30 } } } },
    "techStack": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "maxLength": 30 } },
    "links": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "required": ["label", "value", "url", "logo", "color"], "properties": { "label": { "type": "string", "maxLength": 14 }, "value": { "type": "string", "maxLength": 28 }, "url": { "type": "string", "format": "uri" }, "logo": { "type": "string", "maxLength": 30 }, "color": { "type": "string", "pattern": "^[A-Fa-f0-9]{6}$" } } } },
    "appearance": { "type": "object", "required": ["palette"], "properties": { "palette": { "enum": ["signal", "ocean", "solar"] } } },
    "footer": { "type": "string", "maxLength": 120 }
  }
}
